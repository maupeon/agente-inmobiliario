MOCK_IDEALISTA=true

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Valoración (modelo del TFM) ───────────────────────────────────────────
# Servicio Python con el modelo LightGBM. Si se deja vacío, la app usa la
# heurística de siempre (comparar contra el precio medio provincial del INE).
VALORACION_URL=
VALORACION_TOKEN=
# 10 s cubre el arranque en frío de Fly cuando la máquina está dormida.
VALORACION_TIMEOUT_MS=10000

