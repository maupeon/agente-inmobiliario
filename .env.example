# Copia este archivo a .env.local. Reinicia npm run dev al cambiar variables.
# La configuración inicial usa anuncios sintéticos y desactiva Anthropic.
# Guía completa: docs/configuracion.md. Nunca publiques credenciales reales.

# Anuncios: true = demo; false = API real, con credenciales y cuota en Supabase.
MOCK_IDEALISTA=true
IDEALISTA_API_KEY=
IDEALISTA_SECRET=
IDEALISTA_BASE_URL=https://api.idealista.com/3.5/
IDEALISTA_MONTHLY_LIMIT=100

# Chat y explicación adicional (servicios opcionales de pago).
LLM_ENABLED=false
LLM_INSIGHTS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
INSIGHTS_MODEL=claude-sonnet-4-6

# Historial y favoritos compartidos, caché, cuota y notificaciones.
# La app accede desde el servidor: no necesita una clave pública anon.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Servicio Python EXTERNO. Sin él no hay valoración individual del modelo.
# Ejemplo local, cuando el servicio esté arrancado: http://127.0.0.1:8000
VALORACION_URL=
VALORACION_TOKEN=
VALORACION_TIMEOUT_MS=10000

# Trayectos: sin clave ORS se usan aproximaciones explícitas.
# MOCK_COMMUTE=true fuerza aproximaciones aunque exista una clave.
ORS_API_KEY=
MOCK_COMMUTE=true

# Origen de esta instalación; en producción usa su URL HTTPS canónica.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron (opcional). Mínimo 24 caracteres aleatorios, compartidos con Vault.
# Deja vacío para la demo local. Instalación: docs/notificaciones.md.
CRON_SECRET=
