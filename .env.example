# ─── Agente ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
# false desactiva chat pagado; la narración extra requiere opt-in explícito.
LLM_ENABLED=true
LLM_INSIGHTS_ENABLED=false

# ─── Idealista ─────────────────────────────────────────────────────────────
IDEALISTA_API_KEY=
IDEALISTA_SECRET=
IDEALISTA_BASE_URL=https://api.idealista.com/3.5/
IDEALISTA_MONTHLY_LIMIT=100
# Las búsquedas reales requieren supabase/migrations/20260908_demo_privacy_quota.sql.
# Si la reserva atómica no está disponible, se bloquean las llamadas nuevas.
MOCK_IDEALISTA=true

# ─── Supabase ──────────────────────────────────────────────────────────────
# Historial y favoritos globales: aplicar 20260909_shared_demo_storage.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Valoración (modelo del TFM) ───────────────────────────────────────────
# Servicio Python con el modelo LightGBM. Si se deja vacío, la app usa la
# referencia territorial, etiquetada como alternativa sin valoración del modelo.
VALORACION_URL=
VALORACION_TOKEN=
# 10 s cubre el arranque en frío de Fly cuando la máquina está dormida.
VALORACION_TIMEOUT_MS=10000

# ─── Otros ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Selección diaria de viviendas ─────────────────────────────────────────
# Hora por perfil: 07:00 Europe/Madrid por defecto; editable en /notificaciones.
# Aplicar 20260909150000_daily_notifications.sql y supabase/setup/notifications-cron.sql.
# Secreto compartido entre la app y Supabase Vault (habitia_cron_secret).
# Al menos 24 caracteres aleatorios. Solo servidor; nunca NEXT_PUBLIC_.
CRON_SECRET=
# NEXT_PUBLIC_SITE_URL debe ser el origen HTTPS canónico de la app desplegada.
# La instalación usa una sesión Supabase CLI administrativa, no service_role.
