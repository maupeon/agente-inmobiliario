{
  "name": "habitia",
  "version": "0.1.0",
  "private": true,
  "description": "HabitIA: aplicación web de búsqueda, comparación y valoración de vivienda para el TFM.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib types middleware.ts tailwind.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.105.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "maplibre-gl": "6.10.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
